# Copia este archivo como ".env" y ajusta los valores antes de desplegar.

# Puerto donde escucha el servidor dentro del contenedor.
PORT=3000

# Clave secreta usada para firmar los tokens JWT. OBLIGATORIA.
# Genera una propia, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-propia-y-larga

# Tiempo de expiración de la sesión del personal.
JWT_EXPIRA_EN=8h

# Credenciales del usuario administrador que se crea automáticamente
# la primera vez que arranca el sistema (solo si la tabla usuarios está vacía).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador

NODE_ENV=production
